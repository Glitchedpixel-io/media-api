# Application
APP_ENV=production
DEBUG=false
LOG_LEVEL=info
CONSOLE_LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/media
DATABASE_POOL_SIZE=5
LOGFIRE_FOR_SQLALCHEMY=false
# Connection URL used by Alembic migrations. Optional — falls back to DATABASE_URL.
# Set this to run migrations under a privileged migration role distinct from the
# app's runtime user. Injected by alembic/env.py; never hardcode it in alembic.ini.
ALEMBIC_DATABASE_URL=
# Optional production hardening: if set, migrations `SET ROLE` to this role so
# created objects are owned by it (the connecting login role must be a member).
# Leave unset for dev/CI/contributor databases — objects are then owned by the
# connecting user and migrations build from an empty DB with no role setup.
ALEMBIC_OWNER_ROLE=

# CORS — comma-separated list of allowed origins for this environment.
# Defaults to localhost dev origins if unset; set your real origin(s) in production.
CORS_ORIGINS=https://library.example.com

# Auth (OIDC — Keycloak-shaped defaults, but any standard OIDC provider works)
OIDC_ISSUER=https://id.example.com/realms/RealmName
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
# Bypasses JWT verification with a stub admin principal. Local dev only —
# refused at startup if APP_ENV=production.
AUTH_DISABLED=false

# Filesystem roots
MEDIA_ROOT=/mnt/media
ACCESSORY_ROOT=/mnt/accessory-store
INBOX_ROOT=/mnt/inbox

# Elasticsearch (all optional)
ELASTICSEARCH_URL=
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_INSECURE=false
ES_CA_CERT=
TRANSCRIPTS_INDEX=transcript-segments

# Orchestration providers (optional). Empty by default is a pure pull model —
# no orchestration framework required to boot. Comma-separated provider keys
# to enable, e.g. "prefect,webhook" — only enabled providers are discovered
# from the media_api.orchestration_providers entry-point group and
# instantiated (enabling "prefect" requires the optional prefect extra:
# `uv add media-api[prefect]`). Routing is carried by each request's own
# transform_type (a provider-qualified key, `<provider>.<provider-local-type>`,
# e.g. "prefect.transcode") — there is no routing map to configure here, only
# provider-scoped construction options as a JSON object.
ENABLED_ORCHESTRATION_PROVIDERS=
ORCHESTRATION_PROVIDER_OPTIONS=

# Logfire (optional)
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev
# Repository URL used for Logfire code-source links. Empty by default.
LOGFIRE_CODE_SOURCE_REPOSITORY=
